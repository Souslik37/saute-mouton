---
// Mouton décoratif (laine blanche, tête sombre). Purement visuel : aria-hidden.
interface Props { class?: string; flip?: boolean }
const { class: cls = '', flip = false } = Astro.props;
---
<svg class={cls} viewBox="0 0 120 90" aria-hidden="true" focusable="false" style={flip ? 'transform:scaleX(-1)' : undefined}>
  <g fill="#102a1c">
    <rect x="34" y="62" width="7" height="22" rx="3.5" />
    <rect x="76" y="62" width="7" height="22" rx="3.5" />
  </g>
  <g fill="#fff" stroke="#102a1c" stroke-width="3">
    <path d="M30 58c-12 0-16-14-6-19-4-12 10-20 18-13 4-10 20-11 25-1 8-7 22-2 21 9 11 2 12 18 1 21 2 10-11 15-17 9-5 7-18 7-22 0-8 6-21 2-20-6z" />
  </g>
  <ellipse cx="98" cy="40" rx="13" ry="16" fill="#102a1c" />
  <ellipse cx="87" cy="31" rx="8" ry="4" fill="#102a1c" transform="rotate(-25 87 31)" />
  <circle cx="102" cy="36" r="2.6" fill="#fff" />
  <path d="M86 22c4-6 12-6 16 0" fill="#fff" stroke="#102a1c" stroke-width="3" />
</svg>
