---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ChateauGrid from '../../components/ChateauGrid.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, chateaux } from '../../lib/data';
import { ui } from '../../lib/i18n';
const t = ui();
const p = t.pages.chateaux;
---
<BaseLayout title={p.title} description={p.description}>
  <PageHeader title={p.h1} lead={p.lead}>
    <p class="mt-3 text-muted">{site.fr.deliveryNote} {site.fr.weekendNote} {site.fr.priceNote}</p>
  </PageHeader>
  <section class="container-x"><ChateauGrid items={chateaux} headingLevel="h2" /></section>
  <CtaBand />
</BaseLayout>
