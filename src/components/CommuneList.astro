---
import { communes, type Commune } from '../lib/data';
import { routes, DEFAULT_LOCALE, type Locale } from '../lib/i18n';
interface Props { items?: Commune[]; locale?: Locale }
const { items = communes, locale = DEFAULT_LOCALE } = Astro.props;
---
<ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3" role="list">
  {items.map((c) => (
    <li>
      <a href={routes(locale).commune(c.slug)} class="flex min-h-14 items-center justify-between gap-3 rounded-2xl bg-white px-5 font-semibold text-ink no-underline hover:bg-accent-soft">
        <span class="flex items-center gap-3">
          <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0 text-accent" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 10-14 0c0 5.8 7 12 7 12z" fill="currentColor" /><circle cx="12" cy="10" r="2.6" fill="#fff" /></svg>
          {c.name}
        </span>
        <span class="text-sm text-muted">{c.postalCode}</span>
      </a>
    </li>
  ))}
</ul>
