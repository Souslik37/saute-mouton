---
import { site } from '../lib/data';
---
<ol class="relative grid gap-8 md:grid-cols-3 md:gap-6" role="list">
  {site.fr.steps.map((s, i) => (
    <li class="relative flex gap-5 md:flex-col md:gap-4">
      <span class="relative flex h-16 w-16 shrink-0 items-center justify-center" aria-hidden="true">
        <svg viewBox="0 0 64 64" class="absolute inset-0 h-full w-full"><path d="M14 46C4 46 2 34 10 31 7 21 18 15 25 20c3-9 17-9 19 0 8-4 17 2 15 10 8 3 7 16-2 17 0 8-10 11-15 6-4 6-14 6-17 0-6 4-15 1-14-6z" fill="#fff" stroke="#1d7a3e" stroke-width="3" /></svg>
        <span class="relative font-display text-2xl font-extrabold text-accent-ink">{i + 1}</span>
      </span>
      <div>
        <h3 class="text-xl">{s.title}</h3>
        <p class="mt-1.5 text-muted">{s.text}</p>
      </div>
    </li>
  ))}
</ol>
