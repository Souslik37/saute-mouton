---
import Sheep from './Sheep.astro';
import { ui, routes, DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { whatsappUrl } from '../lib/contact';
interface Props { locale?: Locale; href?: string }
const { locale = DEFAULT_LOCALE, href } = Astro.props;
const t = ui(locale);
---
<section class="container-x mt-24" aria-labelledby="cta-title">
  <div class="relative overflow-hidden rounded-[2rem] bg-forest px-6 pt-12 pb-20 text-center text-white sm:px-12">
    <h2 id="cta-title" class="text-3xl sm:text-4xl">{t.cta.finalTitle}</h2>
    <p class="mx-auto mt-3 max-w-xl text-lg text-white/90">{t.cta.finalText}</p>
    <div class="relative z-10 mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a href={href ?? routes(locale).reserver} class="btn bg-white text-forest hover:bg-accent-soft">{t.cta.book}</a>
      <a href={whatsappUrl(t.form.whatsappIntro)} class="btn border-2 border-white text-white hover:bg-white/10" rel="noopener" target="_blank">
        {t.cta.whatsapp}<span class="sr-only"> (nouvelle fenêtre)</span>
      </a>
    </div>
    <svg class="absolute inset-x-0 bottom-0 h-14 w-full" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true"><path fill="#1d7a3e" d="M0 30c50-18 100-18 150 0s100 18 150 0 100-18 150 0 100 18 150 0 100-18 150 0 100 18 150 0 100-18 150 0 100 18 150 0V60H0z" /></svg>
    <Sheep class="absolute bottom-4 left-4 h-14 w-auto sm:left-10 sm:h-20" />
    <Sheep class="absolute right-4 bottom-5 h-10 w-auto sm:right-14 sm:h-14" flip />
  </div>
</section>
