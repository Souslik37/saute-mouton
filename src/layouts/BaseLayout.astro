---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../lib/data';
import { ui, withBase, DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { localBusiness } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: object[];
  locale?: Locale;
  hideMobileBar?: boolean;
}
const { title, description, noindex = false, ogImage = withBase('/og-default.jpg'), jsonLd = [], locale = DEFAULT_LOCALE, hideMobileBar = false } = Astro.props;
const t = ui(locale);
const canonical = new URL(Astro.url.pathname, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#fff8f0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={[localBusiness(), ...jsonLd]} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenu" class="sr-only z-50 rounded-full bg-ink px-4 py-2 font-bold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3">
      {t.skipToContent}
    </a>
    {site.demo && (
      <p class="bg-ink px-4 py-1.5 text-center text-sm font-semibold text-white">{site.fr.demoNotice}</p>
    )}
    <Header locale={locale} />
    <main id="contenu" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    {!hideMobileBar && <MobileBar locale={locale} />}
  </body>
</html>
