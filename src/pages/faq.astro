---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faq } from '../lib/data';
import { ui } from '../lib/i18n';
import { faqPage } from '../lib/jsonld';
const p = ui().pages.faq;
const items = faq.map((f) => ({ id: f.id, ...f.fr }));
// On n'expose pas dans le JSON-LD les réponses encore en [PLACEHOLDER]
const ld = faqPage(items.filter((i) => !/\[[^\]]+\]/.test(i.a)));
---
<BaseLayout title={p.title} description={p.description} jsonLd={[ld]}>
  <PageHeader title={p.h1} lead={p.lead} />
  <section class="container-x max-w-3xl"><FaqList items={items} headingLevel="h2" /></section>
  <CtaBand />
</BaseLayout>
