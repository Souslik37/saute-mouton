---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { ui, routes } from '../lib/i18n';
const p = ui().pages.notFound;
---
<BaseLayout title={p.title} description={p.description} noindex>
  <PageHeader title={p.h1} lead={p.lead}>
    <a href={routes().home} class="btn-primary mt-8">{p.back}</a>
  </PageHeader>
</BaseLayout>
