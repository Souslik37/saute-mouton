---
import Logo from './Logo.astro';
import { site, communes } from '../lib/data';
import { ui, routes, DEFAULT_LOCALE, type Locale } from '../lib/i18n';
import { rich } from '../lib/format';
interface Props { locale?: Locale }
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = ui(locale);
const r = routes(locale);
const email = site.contact.email;
const emailIsSet = !email.startsWith('[');
---
<footer class="mt-24 bg-forest text-white">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="flex items-center gap-2 font-display text-2xl font-extrabold"><Logo class="h-10 w-10" light />{site.name}</p>
      <p class="mt-3 text-white/85">{site.fr.tagline}</p>
    </div>
    <nav aria-label={t.footer.zoneTitle}>
      <h2 class="mb-3 text-lg">{t.footer.zoneTitle}</h2>
      <ul class="columns-2 gap-4 text-sm">
        {communes.map((c) => <li class="mb-2"><a href={r.commune(c.slug)} class="text-white">{c.name}</a></li>)}
      </ul>
    </nav>
    <div>
      <h2 class="mb-3 text-lg">{t.footer.contactTitle}</h2>
      <ul class="space-y-2 text-white/90">
        <li>{site.owner.firstName}</li>
        <li set:html={rich(site.contact.phoneDisplay)} />
        <li>{emailIsSet ? <a href={`mailto:${email}`} class="text-white">{email}</a> : <Fragment set:html={rich(email)} />}</li>
        <li>{site.legal.address.postalCode} {site.legal.address.city}</li>
      </ul>
    </div>
    <nav aria-label={t.nav.footerLabel}>
      <h2 class="mb-3 text-lg">{t.footer.legalTitle}</h2>
      <ul class="space-y-2">
        <li><a href={r.conditions} class="text-white">{t.footer.conditions}</a></li>
        <li><a href={r.faq} class="text-white">{t.nav.faq}</a></li>
        <li><a href={r.about} class="text-white">{t.nav.about}</a></li>
        <li><a href={r.mentions} class="text-white">{t.footer.mentions}</a></li>
        <li><a href={r.confidentialite} class="text-white">{t.footer.confidentialite}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/15">
    <div class="container-x flex flex-col gap-2 py-5 text-sm text-white/80 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {site.name} · {t.footer.bce} <span set:html={rich(site.legal.bce)} /></p>
      <p>{t.footer.noCookies}</p>
    </div>
  </div>
</footer>
